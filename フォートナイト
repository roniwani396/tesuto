<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Battle Arena - フォートナイト風ゲーム</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { 
      background: #0a0a15; 
      font-family: 'Orbitron', sans-serif;
      overflow: hidden;
    }
    #root { 
      width: 100vw; 
      height: 100vh; 
      display: flex; 
      align-items: center; 
      justify-content: center;
    }
    canvas { 
      border: 4px solid #4ecdc4; 
      border-radius: 8px; 
      box-shadow: 0 0 30px rgba(78, 205, 196, 0.4);
      cursor: crosshair;
    }
  </style>
</head>
<body>
  <div id="root"></div>
  <script type="text/babel">
    const { useState, useEffect, useRef, useCallback } = React;

    // 武器タイプ - 初期弾薬を150発に
    const WEAPONS = {
      fists: { id: 'fists', name: '拳', type: 'melee', damage: 10, fireRate: 500, ammo: Infinity, maxAmmo: Infinity, spread: 0, projectileSpeed: 0 },
      shotgun: { id: 'shotgun', name: 'ショットガン', type: 'ranged', damage: 20, fireRate: 800, ammo: 150, maxAmmo: 150, spread: 0.4, projectileSpeed: 700 },
      rifle: { id: 'rifle', name: 'アサルトライフル', type: 'ranged', damage: 12, fireRate: 80, ammo: 150, maxAmmo: 150, spread: 0.08, projectileSpeed: 900 },
      machinegun: { id: 'machinegun', name: 'マシンガン', type: 'ranged', damage: 8, fireRate: 60, ammo: 150, maxAmmo: 150, spread: 0.2, projectileSpeed: 850 },
      rocket: { id: 'rocket', name: 'ロケットランチャー', type: 'explosive', damage: 100, fireRate: 2000, ammo: 150, maxAmmo: 150, spread: 0, projectileSpeed: 350 },
    };

    const WEAPON_LIST = [
      { id: 'shotgun', name: 'ショットガン', desc: '高ダメージ・遅い発射' },
      { id: 'rifle', name: 'アサルトライフル', desc: 'バランス良好' },
      { id: 'machinegun', name: 'マシンガン', desc: '快速射撃・低ダメージ' },
      { id: 'rocket', name: 'ロケットランチャー', desc: '爆発・高ダメージ' },
    ];

    const WORLD_SIZE = 4000;
    const ZONE_DAMAGE = 3;
    const INITIAL_ENEMIES = 15;
    const INITIAL_ALLIES = 3;

    function createInitialPlayer(startWeapon = 'rifle') {
      return {
        id: 'player',
        position: { x: WORLD_SIZE / 2, y: WORLD_SIZE / 2 },
        velocity: { x: 0, y: 0 },
        angle: 0,
        health: 100,
        maxHealth: 100,
        shield: 50,
        maxShield: 100,
        ammo: { fists: Infinity, shotgun: 150, rifle: 150, machinegun: 150, rocket: 150 },
        currentWeapon: startWeapon,
        isGrounded: true,
        isBuilding: false,
        buildMode: null,
        materials: { wood: 500, stone: 500, metal: 500 },
      };
    }

    function createAlly(index, playerPos) {
      const angle = Math.random() * Math.PI * 2;
      const distance = 100 + Math.random() * 80;
      return {
        id: `ally-${index}`,
        position: { x: playerPos.x + Math.cos(angle) * distance, y: playerPos.y + Math.sin(angle) * distance },
        health: 80,
        maxHealth: 80,
        state: 'follow',
        lastAttackTime: 0,
      };
    }

    function createEnemy(index) {
      const angle = (index / INITIAL_ENEMIES) * Math.PI * 2;
      const distance = 500 + Math.random() * 800;
      return {
        id: `enemy-${index}`,
        position: { x: WORLD_SIZE / 2 + Math.cos(angle) * distance, y: WORLD_SIZE / 2 + Math.sin(angle) * distance },
        health: 50,
        state: 'patrol',
        targetId: null,
        lastAttackTime: 0,
      };
    }

    function Game() {
      const canvasRef = useRef(null);
      const [gameState, setGameState] = useState({
        status: 'selecting',
        players: [],
        allies: [],
        enemies: [],
        projectiles: [],
        buildings: [],
        zone: { center: { x: WORLD_SIZE / 2, y: WORLD_SIZE / 2 }, radius: WORLD_SIZE * 0.7, targetRadius: WORLD_SIZE * 0.15, shrinking: false, damage: ZONE_DAMAGE },
        remainingPlayers: 1,
        elapsedTime: 0,
      });
      
      const [selectedWeapon, setSelectedWeapon] = useState('rifle');
      
      const keysRef = useRef(new Set());
      const mousePositionRef = useRef({ x: 0, y: 0 });
      const mouseDownRef = useRef(false);
      const lastTimeRef = useRef(0);
      const lastShootTimeRef = useRef(0);
      const gameStateRef = useRef(gameState);
      const canvasClickHandlerRef = useRef(null);

      useEffect(() => {
        gameStateRef.current = gameState;
      }, [gameState]);

      const initGame = useCallback((weapon) => {
        const enemies = Array.from({ length: INITIAL_ENEMIES }, (_, i) => createEnemy(i));
        const player = createInitialPlayer(weapon);
        const allies = Array.from({ length: INITIAL_ALLIES }, (_, i) => createAlly(i, player.position));
        
        const newState = {
          status: 'playing',
          players: [player],
          allies,
          enemies,
          projectiles: [],
          buildings: [],
          zone: { center: { x: WORLD_SIZE / 2, y: WORLD_SIZE / 2 }, radius: WORLD_SIZE * 0.7, targetRadius: WORLD_SIZE * 0.15, shrinking: false, damage: ZONE_DAMAGE },
          remainingPlayers: enemies.length + 1 + INITIAL_ALLIES,
          elapsedTime: 0,
        };
        setGameState(newState);
        gameStateRef.current = newState;
        keysRef.current = new Set();
      }, []);

      const updateGame = useCallback((deltaTime) => {
        const prev = gameStateRef.current;
        
        if (prev.status !== 'playing') return;
        
        const player = prev.players[0];
        if (!player) return;

        const keys = keysRef.current;
        const mousePosition = mousePositionRef.current;
        const mouseDown = mouseDownRef.current;

        // プレイヤー移動
        const speed = 320;
        let dx = 0, dy = 0;
        if (keys.has('w') || keys.has('arrowup')) dy -= 1;
        if (keys.has('s') || keys.has('arrowdown')) dy += 1;
        if (keys.has('a') || keys.has('arrowleft')) dx -= 1;
        if (keys.has('d') || keys.has('arrowright')) dx += 1;

        if (dx !== 0 || dy !== 0) {
          const len = Math.sqrt(dx * dx + dy * dy);
          dx = (dx / len) * speed * deltaTime;
          dy = (dy / len) * speed * deltaTime;
          player.position.x = Math.max(50, Math.min(WORLD_SIZE - 50, player.position.x + dx));
          player.position.y = Math.max(50, Math.min(WORLD_SIZE - 50, player.position.y + dy));
        }

        // プレイヤー角度 - マウス方向に向く
        const cameraOffset = { x: 400, y: 300 };
        const worldMouseX = mousePosition.x + cameraOffset.x - 400;
        const worldMouseY = mousePosition.y + cameraOffset.y - 300;
        player.angle = Math.atan2(worldMouseY - player.position.y, worldMouseX - player.position.x);

        // 射撃
        const now = Date.now();
        const weapon = WEAPONS[player.currentWeapon];
        if (mouseDown && weapon && now - lastShootTimeRef.current > weapon.fireRate) {
          if (player.ammo[player.currentWeapon] > 0) {
            player.ammo[player.currentWeapon]--;
            lastShootTimeRef.current = now;
            
            if (weapon.type === 'melee') {
              prev.enemies.forEach(enemy => {
                const dist = Math.sqrt(Math.pow(enemy.position.x - player.position.x, 2) + Math.pow(enemy.position.y - player.position.y, 2));
                if (dist < 60) enemy.health -= weapon.damage;
              });
            } else {
              const spread = (Math.random() - 0.5) * weapon.spread;
              const angle = player.angle + spread;
              
              // ショットガンは複数発
              if (weapon.id === 'shotgun') {
                for (let i = 0; i < 5; i++) {
                  const pelletAngle = angle + (Math.random() - 0.5) * 0.3;
                  prev.projectiles.push({
                    id: `proj-${now}-${i}`,
                    position: { x: player.position.x + Math.cos(angle) * 30, y: player.position.y + Math.sin(angle) * 30 + 10 },
                    velocity: { x: Math.cos(pelletAngle) * weapon.projectileSpeed, y: Math.sin(pelletAngle) * weapon.projectileSpeed },
                    ownerId: player.id,
                    damage: weapon.damage,
                    type: weapon.type,
                    lifetime: 3,
                  });
                }
              } else {
                prev.projectiles.push({
                  id: `proj-${now}`,
                  position: { x: player.position.x + Math.cos(angle) * 30, y: player.position.y + Math.sin(angle) * 30 + 10 },
                  velocity: { x: Math.cos(angle) * weapon.projectileSpeed, y: Math.sin(angle) * weapon.projectileSpeed },
                  ownerId: player.id,
                  damage: weapon.damage,
                  type: weapon.type,
                  lifetime: 3,
                });
              }
            }
          }
        }

        // 建築モード切替
        if (keys.has('b') && !player.isBuilding) {
          player.isBuilding = true;
          player.buildMode = 'wall';
        }

        // 建築配置
        if (keys.has(' ') && player.isBuilding && player.buildMode && player.materials.wood >= 50) {
          player.materials.wood -= 50;
          prev.buildings.push({
            id: `building-${now}`,
            type: player.buildMode,
            position: { x: player.position.x + Math.cos(player.angle) * 80, y: player.position.y + Math.sin(player.angle) * 80 },
            health: 100,
            maxHealth: 100,
            material: 'wood',
          });
        }

        // 味方AI
        prev.allies.forEach(ally => {
          const distToPlayer = Math.sqrt(Math.pow(ally.position.x - player.position.x, 2) + Math.pow(ally.position.y - player.position.y, 2));
          
          if (distToPlayer > 150) {
            const angle = Math.atan2(player.position.y - ally.position.y, player.position.x - ally.position.x);
            ally.position.x += Math.cos(angle) * 180 * deltaTime;
            ally.position.y += Math.sin(angle) * 180 * deltaTime;
          }
          
          let closestEnemy = null;
          let closestDist = 300;
          
          prev.enemies.forEach(enemy => {
            const dist = Math.sqrt(Math.pow(enemy.position.x - ally.position.x, 2) + Math.pow(enemy.position.y - ally.position.y, 2));
            if (dist < closestDist) {
              closestDist = dist;
              closestEnemy = enemy;
            }
          });
          
          if (closestEnemy && now - ally.lastAttackTime > 800) {
            const angle = Math.atan2(closestEnemy.position.y - ally.position.y, closestEnemy.position.x - ally.position.x);
            prev.projectiles.push({
              id: `ally-proj-${now}-${ally.id}`,
              position: { ...ally.position },
              velocity: { x: Math.cos(angle) * 600, y: Math.sin(angle) * 600 },
              ownerId: ally.id,
              damage: 8,
              type: 'ranged',
              lifetime: 2,
            });
            ally.lastAttackTime = now;
          }
          
          ally.position.x = Math.max(50, Math.min(WORLD_SIZE - 50, ally.position.x));
          ally.position.y = Math.max(50, Math.min(WORLD_SIZE - 50, ally.position.y));
        });

        // 敵AI
        prev.enemies.forEach(enemy => {
          const distToPlayer = Math.sqrt(Math.pow(enemy.position.x - player.position.x, 2) + Math.pow(enemy.position.y - player.position.y, 2));
          
          let closestTarget = player;
          let closestDist = distToPlayer;
          
          prev.allies.forEach(ally => {
            const dist = Math.sqrt(Math.pow(enemy.position.x - ally.position.x, 2) + Math.pow(enemy.position.y - ally.position.y, 2));
            if (dist < closestDist) {
              closestDist = dist;
              closestTarget = ally;
            }
          });
          
          if (closestDist < 450) {
            enemy.state = 'chase';
            const angle = Math.atan2(closestTarget.position.y - enemy.position.y, closestTarget.position.x - enemy.position.x);
            enemy.position.x += Math.cos(angle) * 110 * deltaTime;
            enemy.position.y += Math.sin(angle) * 110 * deltaTime;
            if (closestDist < 55 && now - enemy.lastAttackTime > 1200) {
              closestTarget.health -= 8;
              enemy.lastAttackTime = now;
            }
          } else {
            enemy.state = 'patrol';
            enemy.position.x += (Math.random() - 0.5) * 60 * deltaTime;
            enemy.position.y += (Math.random() - 0.5) * 60 * deltaTime;
          }
          enemy.position.x = Math.max(50, Math.min(WORLD_SIZE - 50, enemy.position.x));
          enemy.position.y = Math.max(50, Math.min(WORLD_SIZE - 50, enemy.position.y));
        });

        // 弾丸更新
        prev.projectiles = prev.projectiles.filter(proj => {
          proj.position.x += proj.velocity.x * deltaTime;
          proj.position.y += proj.velocity.y * deltaTime;
          proj.lifetime -= deltaTime;
          
          for (const enemy of prev.enemies) {
            const dist = Math.sqrt(Math.pow(proj.position.x - enemy.position.x, 2) + Math.pow(proj.position.y - enemy.position.y, 2));
            if (dist < 30) { enemy.health -= proj.damage; return false; }
          }
          
          for (const building of prev.buildings) {
            const dist = Math.sqrt(Math.pow(proj.position.x - building.position.x, 2) + Math.pow(proj.position.y - building.position.y, 2));
            if (dist < 40) { building.health -= proj.damage; return false; }
          }
          
          return proj.lifetime > 0;
        });

        const aliveEnemies = prev.enemies.filter(e => e.health > 0);
        const aliveAllies = prev.allies.filter(a => a.health > 0);
        prev.remainingPlayers = aliveEnemies.length + 1 + aliveAllies.length;

        if (player.health <= 0) {
          setTimeout(() => initGame(selectedWeapon), 2000);
          prev.status = 'lost';
        } else if (aliveEnemies.length === 0) {
          prev.status = 'won';
        }

        if (prev.elapsedTime > 15) prev.zone.shrinking = true;
        if (prev.zone.shrinking && prev.zone.radius > prev.zone.targetRadius) prev.zone.radius -= 8 * deltaTime;

        const distFromZone = Math.sqrt(Math.pow(player.position.x - prev.zone.center.x, 2) + Math.pow(player.position.y - prev.zone.center.y, 2));
        if (distFromZone > prev.zone.radius) player.health -= prev.zone.damage * deltaTime;

        prev.allies.forEach(ally => {
          const allyDistFromZone = Math.sqrt(Math.pow(ally.position.x - prev.zone.center.x, 2) + Math.pow(ally.position.y - prev.zone.center.y, 2));
          if (allyDistFromZone > prev.zone.radius) ally.health -= prev.zone.damage * deltaTime;
        });

        prev.elapsedTime += deltaTime;
        
        gameStateRef.current = { ...prev };
        setGameState({ ...prev });
      }, [selectedWeapon, initGame]);

      const handleKeyDown = useCallback((e) => {
        const key = e.key.toLowerCase();
        keysRef.current = new Set([...keysRef.current, key]);
        
        if (key === '1') {
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].currentWeapon = 'fists';
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].isBuilding = false;
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].buildMode = null;
        }
        if (key === '2') {
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].currentWeapon = 'shotgun';
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].isBuilding = false;
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].buildMode = null;
        }
        if (key === '3') {
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].currentWeapon = 'rifle';
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].isBuilding = false;
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].buildMode = null;
        }
        if (key === '4') {
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].currentWeapon = 'machinegun';
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].isBuilding = false;
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].buildMode = null;
        }
        if (key === '5') {
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].currentWeapon = 'rocket';
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].isBuilding = false;
          if (gameStateRef.current.players[0]) gameStateRef.current.players[0].buildMode = null;
        }
        if (key === 'q') {
          if (gameStateRef.current.players[0]) { gameStateRef.current.players[0].isBuilding = true; gameStateRef.current.players[0].buildMode = 'wall'; }
        }
        if (key === 'e') {
          if (gameStateRef.current.players[0]) { gameStateRef.current.players[0].isBuilding = true; gameStateRef.current.players[0].buildMode = 'ramp'; }
        }
        if (key === 'f') {
          if (gameStateRef.current.players[0]) { gameStateRef.current.players[0].isBuilding = true; gameStateRef.current.players[0].buildMode = 'floor'; }
        }
        if (key === 'escape') {
          if (gameStateRef.current.players[0]) { gameStateRef.current.players[0].isBuilding = false; gameStateRef.current.players[0].buildMode = null; }
        }
        if (key === 'r' && gameStateRef.current.status !== 'playing') initGame(selectedWeapon);
      }, [selectedWeapon, initGame]);

      const handleKeyUp = useCallback((e) => {
        const key = e.key.toLowerCase();
        const newKeys = new Set(keysRef.current);
        newKeys.delete(key);
        keysRef.current = newKeys;
      }, []);

      const handleMouseMove = useCallback((e) => {
        const rect = canvasRef.current?.getBoundingClientRect();
        if (rect) mousePositionRef.current = { x: e.clientX - rect.left, y: e.clientY - rect.top };
      }, []);

      // クリックハンドラ - 武器選択とゲーム開始
      const handleCanvasClick = (e) => {
        const rect = canvasRef.current.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        if (gameStateRef.current.status === 'selecting') {
          // 武器選択チェック
          WEAPON_LIST.forEach((weapon, i) => {
            const boxX = 800 / 2 - 280 + i * 190;
            const boxY = 280;
            if (x >= boxX - 70 && x <= boxX + 70 && y >= boxY - 60 && y <= boxY + 80) {
              setSelectedWeapon(weapon.id);
            }
          });
          
          // スタートボタン (より大きな判定範囲)
          const btnX = 800 / 2;
          const btnY = 505;
          const btnW = 200;
          const btnH = 50;
          if (x >= btnX - btnW/2 && x <= btnX + btnW/2 && y >= btnY - btnH/2 && y <= btnY + btnH/2) {
            initGame(selectedWeapon);
          }
        }
      };

      useEffect(() => {
        window.addEventListener('keydown', handleKeyDown);
        window.addEventListener('keyup', handleKeyUp);
        return () => { window.removeEventListener('keydown', handleKeyDown); window.removeEventListener('keyup', handleKeyUp); };
      }, [handleKeyDown, handleKeyUp]);

      useEffect(() => {
        const canvas = canvasRef.current;
        if (!canvas) return;
        canvas.addEventListener('mousemove', handleMouseMove);
        canvas.addEventListener('mousedown', () => mouseDownRef.current = true);
        canvas.addEventListener('mouseup', () => mouseDownRef.current = false);
        canvas.addEventListener('mouseleave', () => mouseDownRef.current = false);
        return () => { 
          canvas.removeEventListener('mousemove', handleMouseMove); 
          canvas.removeEventListener('mousedown', () => mouseDownRef.current = false); 
          canvas.removeEventListener('mouseup', () => mouseDownRef.current = false);
          canvas.removeEventListener('mouseleave', () => mouseDownRef.current = false);
        };
      }, [handleMouseMove]);

      useEffect(() => {
        const gameLoop = (time) => {
          const deltaTime = Math.min((time - lastTimeRef.current) / 1000, 0.1);
          lastTimeRef.current = time;
          if (gameStateRef.current.status === 'playing') updateGame(deltaTime);
          
          const canvas = canvasRef.current;
          const ctx = canvas?.getContext('2d');
          if (ctx && canvas) render(ctx, canvas.width, canvas.height);
          
          requestAnimationFrame(gameLoop);
        };
        requestAnimationFrame(gameLoop);
      }, [updateGame]);

      const render = (ctx, width, height) => {
        const player = gameStateRef.current.players[0];
        
        ctx.fillStyle = '#0a0a15';
        ctx.fillRect(0, 0, width, height);
        
        if (gameStateRef.current.status === 'selecting') {
          renderWeaponSelect(ctx, width, height);
          return;
        }
        
        if (!player) return;

        const cameraX = width / 2 - player.position.x;
        const cameraY = height / 2 - player.position.y;
        ctx.save();
        ctx.translate(cameraX, cameraY);

        // グリッド
        ctx.strokeStyle = '#1a1a2e';
        ctx.lineWidth = 1;
        for (let x = 0; x <= WORLD_SIZE; x += 200) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, WORLD_SIZE); ctx.stroke(); }
        for (let y = 0; y <= WORLD_SIZE; y += 200) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(WORLD_SIZE, y); ctx.stroke(); }

        // ゾーン
        ctx.beginPath();
        ctx.arc(gameStateRef.current.zone.center.x, gameStateRef.current.zone.center.y, gameStateRef.current.zone.radius, 0, Math.PI * 2);
        ctx.strokeStyle = '#e74c3c';
        ctx.lineWidth = 8;
        ctx.setLineDash([30, 15]);
        ctx.stroke();
        ctx.setLineDash([]);

        const gradient = ctx.createRadialGradient(
          gameStateRef.current.zone.center.x, gameStateRef.current.zone.center.y, 0,
          gameStateRef.current.zone.center.x, gameStateRef.current.zone.center.y, gameStateRef.current.zone.radius
        );
        gradient.addColorStop(0, 'rgba(46, 204, 113, 0.1)');
        gradient.addColorStop(1, 'rgba(46, 204, 113, 0)');
        ctx.fillStyle = gradient;
        ctx.fill();

        // 建築
        gameStateRef.current.buildings.forEach(b => {
          ctx.fillStyle = b.material === 'wood' ? '#8b4513' : b.material === 'stone' ? '#808080' : '#4a5568';
          ctx.fillRect(b.position.x - 35, b.position.y - 35, 70, 70);
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 3;
          ctx.strokeRect(b.position.x - 35, b.position.y - 35, 70, 70);
        });

        // 味方
        gameStateRef.current.allies.forEach(ally => {
          if (ally.health <= 0) return;
          ctx.save();
          ctx.translate(ally.position.x, ally.position.y);
          
          ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
          ctx.beginPath(); ctx.ellipse(0, 18, 16, 6, 0, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#2980B9';
          ctx.beginPath(); ctx.ellipse(0, 5, 14, 18, 0, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#F5D0C5';
          ctx.beginPath(); ctx.arc(0, -16, 11, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#3498DB';
          ctx.beginPath(); ctx.arc(0, -19, 10, Math.PI, 0); ctx.fill();
          
          ctx.fillStyle = '#fff';
          ctx.beginPath(); ctx.arc(-3, -16, 3, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(3, -16, 3, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#000';
          ctx.beginPath(); ctx.arc(-3, -16, 1.5, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(3, -16, 1.5, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#333';
          ctx.fillRect(-20, -38, 40, 6);
          ctx.fillStyle = '#2ecc71';
          ctx.fillRect(-20, -38, 40 * (ally.health / ally.maxHealth), 6);
          
          ctx.restore();
        });

        // 敵
        gameStateRef.current.enemies.forEach(enemy => {
          ctx.save();
          ctx.translate(enemy.position.x, enemy.position.y);
          
          ctx.fillStyle = 'rgba(0, 0, 0, 0.3)';
          ctx.beginPath(); ctx.ellipse(0, 20, 18, 7, 0, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#8B0000';
          ctx.beginPath(); ctx.ellipse(0, 6, 16, 20, 0, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#DEB887';
          ctx.beginPath(); ctx.arc(0, -18, 12, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#fff';
          ctx.beginPath(); ctx.arc(-4, -20, 4, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(4, -20, 4, 0, Math.PI * 2); ctx.fill();
          ctx.fillStyle = '#e74c3c';
          ctx.beginPath(); ctx.arc(-4, -20, 2, 0, Math.PI * 2); ctx.fill();
          ctx.beginPath(); ctx.arc(4, -20, 2, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#333';
          ctx.fillRect(-22, -42, 44, 7);
          ctx.fillStyle = '#e74c3c';
          ctx.fillRect(-22, -42, 44 * (enemy.health / 50), 7);
          
          ctx.restore();
        });

        // 弾丸
        gameStateRef.current.projectiles.forEach(proj => {
          const gradient = ctx.createRadialGradient(proj.position.x, proj.position.y, 0, proj.position.x, proj.position.y, 20);
          gradient.addColorStop(0, 'rgba(255, 230, 109, 0.9)');
          gradient.addColorStop(1, 'rgba(255, 230, 109, 0)');
          ctx.fillStyle = gradient;
          ctx.beginPath(); ctx.arc(proj.position.x, proj.position.y, 20, 0, Math.PI * 2); ctx.fill();
          
          ctx.fillStyle = '#ffe66d';
          ctx.beginPath(); ctx.arc(proj.position.x, proj.position.y, 5, 0, Math.PI * 2); ctx.fill();
        });

        // プレイヤー
        ctx.save();
        ctx.translate(player.position.x, player.position.y);
        ctx.rotate(player.angle);
        
        ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
        ctx.beginPath(); ctx.ellipse(0, 22, 22, 9, 0, 0, Math.PI * 2); ctx.fill();
        
        ctx.fillStyle = '#2C3E50';
        ctx.fillRect(-14, 8, 10, 22);
        ctx.fillRect(4, 8, 10, 22);
        
        ctx.fillStyle = '#27AE60';
        ctx.beginPath();
        ctx.moveTo(-16, -8);
        ctx.lineTo(16, -8);
        ctx.lineTo(14, 18);
        ctx.lineTo(-14, 18);
        ctx.closePath();
        ctx.fill();
        
        ctx.strokeStyle = '#1E8449';
        ctx.lineWidth = 2;
        ctx.stroke();
        
        ctx.fillStyle = '#F5D0C5';
        ctx.beginPath(); ctx.arc(0, -16, 13, 0, Math.PI * 2); ctx.fill();
        
        ctx.fillStyle = '#5D4E37';
        ctx.beginPath(); ctx.arc(0, -20, 11, Math.PI, 0); ctx.fill();
        
        ctx.fillStyle = '#fff';
        ctx.beginPath(); ctx.arc(-4, -16, 4, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(4, -16, 4, 0, Math.PI * 2); ctx.fill();
        ctx.fillStyle = '#2C3E50';
        ctx.beginPath(); ctx.arc(-4, -16, 2, 0, Math.PI * 2); ctx.fill();
        ctx.beginPath(); ctx.arc(4, -16, 2, 0, Math.PI * 2); ctx.fill();
        
        ctx.fillStyle = '#F5D0C5';
        ctx.fillRect(16, -6, 10, 20);
        ctx.fillRect(-26, -6, 10, 20);
        
        const weapon = WEAPONS[player.currentWeapon];
        if (weapon) {
          ctx.fillStyle = '#1a1a1a';
          if (weapon.id === 'rifle' || weapon.id === 'machinegun') {
            ctx.fillRect(18, -2, weapon.id === 'machinegun' ? 45 : 38, 7);
            ctx.fillStyle = '#333';
            ctx.fillRect(50, -3, 10, 9);
          } else if (weapon.id === 'shotgun') {
            ctx.fillRect(18, 0, 35, 10);
            ctx.fillStyle = '#8B4513';
            ctx.fillRect(48, -2, 15, 14);
          } else if (weapon.id === 'rocket') {
            ctx.fillStyle = '#c0392b';
            ctx.fillRect(18, -5, 28, 12);
            ctx.fillStyle = '#f39c12';
            ctx.beginPath(); ctx.arc(46, 1, 7, 0, Math.PI * 2); ctx.fill();
          }
        }
        
        ctx.restore();

        // 建築プレビュー
        if (player.isBuilding && player.buildMode) {
          const px = player.position.x + Math.cos(player.angle) * 90;
          const py = player.position.y + Math.sin(player.angle) * 90;
          ctx.fillStyle = 'rgba(139, 69, 19, 0.5)';
          ctx.fillRect(px - 35, py - 35, 70, 70);
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 3;
          ctx.setLineDash([8, 8]);
          ctx.strokeRect(px - 35, py - 35, 70, 70);
          ctx.setLineDash([]);
        }

        ctx.restore();
        renderHUD(ctx, width, height);
      };

      const renderWeaponSelect = (ctx, width, height) => {
        // タイトル
        ctx.fillStyle = '#4ecdc4';
        ctx.font = 'bold 42px Orbitron, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('バトルアリーナ', width / 2, 100);
        
        ctx.fillStyle = '#fff';
        ctx.font = '24px Orbitron, sans-serif';
        ctx.fillText('武器を選んでください', width / 2, 150);
        
        // 武器オプション
        WEAPON_LIST.forEach((weapon, i) => {
          const x = width / 2 - 280 + i * 190;
          const y = 280;
          const isSelected = selectedWeapon === weapon.id;
          
          ctx.fillStyle = isSelected ? '#4ecdc4' : '#16213e';
          ctx.fillRect(x - 70, y - 60, 140, 140);
          ctx.strokeStyle = isSelected ? '#fff' : '#4ecdc4';
          ctx.lineWidth = 3;
          ctx.strokeRect(x - 70, y - 60, 140, 140);
          
          ctx.fillStyle = isSelected ? '#1a1a2e' : '#fff';
          ctx.font = 'bold 16px Orbitron, sans-serif';
          ctx.fillText(weapon.name, x, y - 20);
          
          ctx.font = '11px Orbitron, sans-serif';
          ctx.fillText(weapon.desc, x, y + 10);
          
          ctx.fillStyle = isSelected ? '#1a1a2e' : '#ffe66d';
          ctx.font = 'bold 24px Orbitron, sans-serif';
          ctx.fillText(`${i + 2}`, x, y + 50);
        });
        
        // スタートボタン
        ctx.fillStyle = '#27AE60';
        ctx.fillRect(width / 2 - 100, 480, 200, 50);
        ctx.strokeStyle = '#fff';
        ctx.lineWidth = 3;
        ctx.strokeRect(width / 2 - 100, 480, 200, 50);
        
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 20px Orbitron, sans-serif';
        ctx.fillText('ゲームスタート', width / 2, 513);
        
        ctx.textAlign = 'left';
      };

      const renderHUD = (ctx, width, height) => {
        const player = gameStateRef.current.players[0];
        if (!player) return;

        // 体力バー
        ctx.fillStyle = '#16213e';
        ctx.fillRect(20, height - 70, 220, 35);
        ctx.fillStyle = '#e74c3c';
        ctx.fillRect(22, height - 68, 216 * Math.max(0, player.health / player.maxHealth), 31);
        
        if (player.shield > 0) {
          ctx.fillStyle = '#3498db';
          ctx.fillRect(22, height - 35, 216 * Math.min(1, player.shield / player.maxShield), 10);
        }
        
        ctx.fillStyle = '#fff';
        ctx.font = 'bold 14px Orbitron, sans-serif';
        ctx.fillText(`HP: ${Math.round(Math.max(0, player.health))}`, 250, height - 45);

        // プレイヤー数
        ctx.font = 'bold 22px Orbitron, sans-serif';
        ctx.fillStyle = '#ffe66d';
        ctx.fillText(`👥 ${gameStateRef.current.remainingPlayers}`, width - 140, 45);
        
        const aliveAllies = gameStateRef.current.allies.filter(a => a.health > 0).length;
        if (aliveAllies > 0) {
          ctx.fillStyle = '#3498db';
          ctx.fillText(`+${aliveAllies} 味方`, width - 140, 75);
        }

        // タイマー
        const m = Math.floor(gameStateRef.current.elapsedTime / 60);
        const s = Math.floor(gameStateRef.current.elapsedTime % 60);
        ctx.fillText(`${m}:${s.toString().padStart(2, '0')}`, width - 140, 105);

        // 武器
        const weapon = WEAPONS[player.currentWeapon];
        ctx.fillStyle = '#16213e';
        ctx.fillRect(20, height - 140, 200, 55);
        ctx.fillStyle = '#ff6b35';
        ctx.font = 'bold 18px Orbitron, sans-serif';
        ctx.fillText(weapon.name, 30, height - 110);
        ctx.fillStyle = '#fff';
        ctx.font = '14px Orbitron, sans-serif';
        ctx.fillText(`弾丸: ${player.ammo[player.currentWeapon] === Infinity ? '∞' : player.ammo[player.currentWeapon]}`, 30, height - 85);

        // マテリアル
        ctx.fillStyle = '#16213e';
        ctx.fillRect(width - 220, height - 70, 200, 55);
        ctx.fillStyle = '#8b4513';
        ctx.fillText(`🪵 ${player.materials.wood}`, width - 210, height - 45);
        ctx.fillStyle = '#808080';
        ctx.fillText(`🪨 ${player.materials.stone}`, width - 110, height - 45);

        // 建築モード
        if (player.isBuilding) {
          ctx.fillStyle = '#4ecdc4';
          ctx.font = 'bold 16px Orbitron, sans-serif';
          ctx.fillText(`🔨 建築: ${player.buildMode?.toUpperCase()} (スペース)`, width / 2 - 100, 45);
        }

        // 操作説明
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.font = '11px Orbitron, sans-serif';
        ctx.fillText('WASD: 移動 | クリック: 射撃 | 2-5: 武器 | B: 建築 | Q/E/F: 壁/階段/床', 20, 30);

        // 勝利/敗北
        if (gameStateRef.current.status === 'won') {
          ctx.fillStyle = 'rgba(0, 0, 0, 0.8)';
          ctx.fillRect(0, 0, width, height);
          ctx.fillStyle = '#2ecc71';
          ctx.font = 'bold 52px Orbitron, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('🎉 勝利! 🎉', width / 2, height / 2);
          ctx.font = '24px Orbitron, sans-serif';
          ctx.fillText('Rキーで再プレイ', width / 2, height / 2 + 60);
          ctx.textAlign = 'left';
        } else if (gameStateRef.current.status === 'lost') {
          ctx.fillStyle = 'rgba(0, 0, 0, 0.8)';
          ctx.fillRect(0, 0, width, height);
          ctx.fillStyle = '#e74c3c';
          ctx.font = 'bold 52px Orbitron, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('💀 敗北 💀', width / 2, height / 2);
          ctx.font = '24px Orbitron, sans-serif';
          ctx.fillText('リスタート中...', width / 2, height / 2 + 60);
          ctx.textAlign = 'left';
        }
      };

      return <canvas ref={canvasRef} width={800} height={600} style={{ maxWidth: '100%', maxHeight: '100%' }} onClick={handleCanvasClick} />;
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<Game />);
  </script>
</body>
</html>
